-fn encode_temperature(temp: &Option<f64>) -> (u8, u8, u8) {
-    if let Some(temp) = temp {
-        let ones = (temp / 10.0) as u8;
-        let tens = (temp % 10.0) as u8;
-        let tenths = ((temp * 10.0) % 10.0) as u8;
-        return (ones, tens, tenths);
+/// Tens, ones and tenths of a temperature rounded to 0.1 °C and clamped to the
+/// panel's range of 00.0 to 99.9.
+fn digits(temperature: Option<f64>) -> [u8; 3] {
+    match temperature {
+        Some(t) if t.is_finite() => {
+            let tenths = (t.clamp(0.0, 99.9) * 10.0).round() as u16;
+            [
+                (tenths / 100) as u8,
+                (tenths / 10 % 10) as u8,
+                (tenths % 10) as u8,
+            ]
+        }
+        _ => [NO_READING; 3],
     }
-    (238, 238, 238)
 }
 
